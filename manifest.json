{
"manifest_version": 3,
"default_locale": "en",
"name": "__MSG_extName__",
"version": "0.3.0",
"description": "__MSG_extDescription__",
"icons": {
"48": "icon.jpg",
"96": "icon.jpg"
},
"browser_specific_settings": {
"gecko": {
"id": "gemini-archive-hider@local.mvp",
"strict_min_version": "109.0"
}
},
"permissions": [
"activeTab"
],
"action": {
"default_title": "__MSG_actionTitle__",
"default_popup": "popup.html",
"default_icon": {
"16": "icon.jpg",
"32": "icon.jpg",
"48": "icon.jpg"
}
},
"content_scripts": [
{
"matches": [
"https://gemini.google.com/*"
],
"js": [
"content.js"
],
"run_at": "document_idle"
}
]
}
